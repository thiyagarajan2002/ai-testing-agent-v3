{
  "name": "v3.2 Retry Smoke Test",
  "type": "API",
  "baseUrl": "https://httpbin.org",
  "variables": {
    "version": "3.2.0"
  },
  "steps": [
    {
      "action": "GET",
      "path": "/anything",
      "retryCount": 2,
      "headers": {
        "X-Test-Version": "${version}"
      },
      "query": {
        "source": "ai-testing-agent"
      },
      "assertSpec": {
        "status": 200,
        "contains": "ai-testing-agent"
      },
      "timeoutMs": 30000
    }
  ]
}
