{
  "name": "UI Product Search and Cart",
  "type": "UI",
  "baseUrl": "https://www.saucedemo.com",
  "steps": [
    {"action":"navigate","value":"/"},
    {"action":"fill","locator":"#user-name","value":"standard_user"},
    {"action":"fill","locator":"#password","value":"secret_sauce"},
    {"action":"click","locator":"#login-button"},
    {"action":"fill","locator":".product_sort_container","value":"Price (low to high)"},
    {"action":"click","locator":"#add-to-cart-sauce-labs-backpack"},
    {"action":"click","locator":".shopping_cart_link"},
    {"action":"assertvisible","locator":".cart_item"}
  ]
}
